# Gateway v1 configuration. Copy to .env (local) or export variables.
# NEVER commit real secrets, only this template.
#
# Required:
JWT_SECRET=change-me-please-generate-strong-secret
# Optional issuer check (enforced only when set):
# JWT_ISSUER=auth-module

# Listener:
BIND=0.0.0.0
PORT=1111

# Upstream modules (http://host:port[/prefix]).
# quests/attempts/answers fall back to MODULE_TESTS_URL when empty.
MODULE_USERS_URL=http://127.0.0.1:8081
MODULE_COURSES_URL=http://127.0.0.1:8082
MODULE_QUESTS_URL=
MODULE_TESTS_URL=http://127.0.0.1:8083
MODULE_ATTEMPTS_URL=
MODULE_ANSWERS_URL=

# Timeouts / limits (see docs/API_CONTRACT.md):
UPSTREAM_TIMEOUT_MS=5000
RECV_TIMEOUT_MS=30000
MAX_BODY_BYTES=1048576
MAX_CLIENTS=128
RATE_LIMIT_PER_MIN=100
LOG_LEVEL=info
